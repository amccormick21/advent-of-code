{
    "name": "Go Development",
    "image": "mcr.microsoft.com/devcontainers/go:1-1.21-bullseye",
    "customizations": {
        "vscode": {
            "settings": {
                "go.toolsManagement.checkForUpdates": "local",
                "go.useLanguageServer": true,
                "go.gopath": "/go"
            },
            "extensions": [
                "golang.go",
                "ms-vscode.go",
                "github.copilot",
                "github.copilot-chat",
                "github.vscode-pull-request-github"
            ]
        }
    },
    "mounts": [
        "source=workspaces-amc,target=/workspaces,type=volume,consistency=cached"
    ],
    "postCreateCommand": "go version",
    "remoteUser": "vscode"
}